---
import '@fontsource/inter/latin-400.css';
import '@fontsource/inter/latin-ext-400.css';
import '@fontsource/inter/latin-700.css';
import '@fontsource/inter/latin-ext-700.css';
import '@fontsource/newsreader/latin-400.css';
import '@fontsource/newsreader/latin-ext-400.css';
import '@fontsource/newsreader/latin-700-italic.css';
import '@fontsource/newsreader/latin-ext-700-italic.css';
import '@fontsource/space-grotesk/latin-700.css';
import '@fontsource/space-grotesk/latin-ext-700.css';
import '@fontsource/ibm-plex-mono/latin-700.css';
import '@fontsource/ibm-plex-mono/latin-ext-700.css';
import interLatin400 from '@fontsource/inter/files/inter-latin-400-normal.woff2?url';
import interLatinExt400 from '@fontsource/inter/files/inter-latin-ext-400-normal.woff2?url';
import newsreaderLatin400 from '@fontsource/newsreader/files/newsreader-latin-400-normal.woff2?url';
import newsreaderLatinExt400 from '@fontsource/newsreader/files/newsreader-latin-ext-400-normal.woff2?url';
import '../styles/global.css';
import '../styles/shell.css';

import LangSwitch from '../components/LangSwitch.astro';
import Footer from '../components/shell/Footer.astro';
import Logo from '../components/shell/Logo.astro';
import Strip from '../components/shell/Strip.astro';
import { getStripItems } from '../lib/projects';
import { SITE_DESCRIPTION, SITE_TITLE } from '../config/site';
import { LANG_STORAGE_KEY, LANGS, ui, type Lang } from '../i18n/ui';
import { absoluteUrl, localePath, withBase } from '../lib/paths';

interface Props {
  lang: Lang;
  /** Tab title. Defaults to the site title. */
  title?: string;
  /**
   * Language-neutral path of this page ('/', '/work/01/'). Enables hreflang
   * alternates, the canonical link and the language switch. Omit on the 404 page.
   */
  path?: string;
  /** Czech root page only: go to /en/ if the visitor chose English before. */
  redirectSavedLang?: boolean;
  /**
   * Page kind for the shell state (spec 6.1.5, 6.1.6): the landing page zooms
   * while the works are on screen; work pages start white with the small logo.
   */
  kind?: 'landing' | 'work' | 'other';
}

const { lang, title = SITE_TITLE, path, redirectSavedLang = false, kind = 'other' } = Astro.props;
const stripItems = await getStripItems();
const t = ui[lang];
const enHome = localePath('en', '/');
---

<!doctype html>
<html lang={lang} class:list={[{ 'has-strip': stripItems.length > 0, 'is-zoom': kind === 'work' }]} data-page={kind}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline>
      document.documentElement.classList.add('js');
    </script>
    {
      redirectSavedLang && (
        <script is:inline define:vars={{ key: LANG_STORAGE_KEY, target: enHome }}>
          try {
            if (localStorage.getItem(key) === 'en') {
              location.replace(target + location.search + location.hash);
            }
          } catch (e) {}
        </script>
      )
    }
    {/* Fonts of the first screen, loaded before first paint so the text does not reflow (layout shift). */}
    {
      [interLatin400, interLatinExt400, ...(kind === 'landing' ? [newsreaderLatin400, newsreaderLatinExt400] : [])].map(
        (href) => <link rel="preload" href={href} as="font" type="font/woff2" crossorigin />,
      )
    }
    <title>{title}</title>
    <meta name="description" content={SITE_DESCRIPTION} />
    {
      path && (
        <>
          <link rel="canonical" href={absoluteUrl(localePath(lang, path))} />
          {LANGS.map((l) => (
            <link rel="alternate" hreflang={l} href={absoluteUrl(localePath(l, path))} />
          ))}
          <link rel="alternate" hreflang="x-default" href={absoluteUrl(localePath('cs', path))} />
        </>
      )
    }
    <link rel="icon" href={withBase('favicon.ico')} sizes="32x32" />
    <link rel="icon" href={withBase('favicon.svg')} type="image/svg+xml" />
    <link rel="icon" href={withBase('favicon-64.png')} type="image/png" sizes="64x64" />
    <link rel="apple-touch-icon" href={withBase('apple-touch-icon.png')} />
    <slot name="head" />
  </head>
  <body>
    <a class="skip-link" href="#main">{t.skip}</a>
    <Strip lang={lang} items={stripItems} />
    <div class="frame">
      <aside class="frame__side">
        <Logo lang={lang} />
        {path && <LangSwitch lang={lang} path={path} />}
        <slot name="side" />
      </aside>
      <main id="main" class="frame__main" tabindex="-1">
        <slot />
      </main>
    </div>
    <Footer lang={lang} />
    <script>
      import '../scripts/shell/zoom';
    </script>
  </body>
</html>
