---
// Served by GitHub Pages for any missing path, in both languages.
// Under /work/ it says that the project was not found.
import Base from '../layouts/Base.astro';
import { ui } from '../i18n/ui';
import { localePath } from '../lib/paths';
---

<Base lang="cs" title="404 - TEXT FORMA FUNKCE">
  <h1>404</h1>
  <div data-nf="page">
    <p>Stránka nebyla nalezena.</p>
    <p lang="en">Page not found.</p>
  </div>
  <div data-nf="project" hidden>
    <p>{ui.cs.projectNotFound}</p>
    <p lang="en">{ui.en.projectNotFound}</p>
  </div>
  <p>
    <a href={localePath('cs', '/')}>Úvodní stránka</a> · <a href={localePath('en', '/')} lang="en">Home page</a>
  </p>
  <script is:inline>
    if (/\/work\//.test(location.pathname)) {
      document.querySelector('[data-nf="page"]').hidden = true;
      document.querySelector('[data-nf="project"]').hidden = false;
    }
  </script>
</Base>
