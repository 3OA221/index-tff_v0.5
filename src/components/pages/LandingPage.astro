---
import Base from '../../layouts/Base.astro';
import Works from '../works/Works.astro';
import { ui, type Lang } from '../../i18n/ui';
import { getMediums, getProjects } from '../../lib/projects';
import { SITE_TITLE } from '../../config/site';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = ui[lang];
const [projects, mediums] = await Promise.all([getProjects(), getMediums()]);
---

<Base lang={lang} path="/" redirectSavedLang={lang === 'cs'}>
  <h1 class="visually-hidden">{SITE_TITLE}</h1>
  <section id="about" class="about" aria-label={SITE_TITLE}>
    {t.about.map((para) => <p>{para}</p>)}
  </section>
  <Works lang={lang} projects={projects} mediums={mediums} />
</Base>

<style>
  .about {
    max-width: 30em;
    font-family: var(--font-text);
    font-size: clamp(1.4rem, 2.5vw, 2.15rem);
    line-height: 1.3;
    letter-spacing: -0.005em;
  }
  .about p {
    margin: 0;
  }
  .about p + p {
    margin-top: 1.1em;
  }
</style>
