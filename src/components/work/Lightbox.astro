---
import { fmt, ui, type Lang } from '../../i18n/ui';

interface Props {
  lang: Lang;
  count: number;
}
const { lang, count } = Astro.props;
const t = ui[lang];
---

<dialog class="lightbox" aria-label={t.gallery} data-lightbox>
  <div class="lightbox__stage" data-lightbox-stage>
    <img class="lightbox__img" alt="" data-lightbox-img />
  </div>
  <button type="button" class="lightbox__btn lightbox__close" aria-label={t.close} data-lightbox-close autofocus>
    <svg viewBox="0 0 24 24" width="24" height="24" aria-hidden="true" focusable="false">
      <path d="M5 5l14 14M19 5L5 19" fill="none" stroke="currentColor" stroke-width="1.5"></path>
    </svg>
  </button>
  {
    count > 1 && (
      <div class="lightbox__bar" role="group" aria-label={t.images}>
        {Array.from({ length: count }, (_, i) => (
          <button type="button" class="lightbox__seg" data-lightbox-seg={i} aria-label={fmt(t.imageN, { n: i + 1 })} />
        ))}
      </div>
    )
  }
  <a class="lightbox__btn lightbox__newtab" href="#" target="_blank" rel="noopener" aria-label={t.openNewTab} data-lightbox-newtab>
    <svg viewBox="0 0 24 24" width="24" height="24" aria-hidden="true" focusable="false">
      <path d="M10 5H5v14h14v-5M13 4h7v7M20 4l-9 9" fill="none" stroke="currentColor" stroke-width="1.5"></path>
    </svg>
  </a>
  {
    count > 1 && (
      <>
        <button type="button" class="lightbox__btn lightbox__prev" aria-label={t.previousLabel} data-lightbox-prev>
          <svg viewBox="0 0 24 24" width="24" height="24" aria-hidden="true" focusable="false">
            <path d="M15 4l-8 8 8 8" fill="none" stroke="currentColor" stroke-width="1.5" />
          </svg>
        </button>
        <button type="button" class="lightbox__btn lightbox__next" aria-label={t.nextLabel} data-lightbox-next>
          <svg viewBox="0 0 24 24" width="24" height="24" aria-hidden="true" focusable="false">
            <path d="M9 4l8 8-8 8" fill="none" stroke="currentColor" stroke-width="1.5" />
          </svg>
        </button>
      </>
    )
  }
  <p class="visually-hidden" role="status" data-lightbox-status></p>
</dialog>

<script>
  import '../../scripts/lightbox';
</script>
