---
import { LANGS, ui, type Lang } from '../i18n/ui';
import { localePath } from '../lib/paths';

interface Props {
  lang: Lang;
  /** Language-neutral path of the current page. */
  path: string;
}
const { lang, path } = Astro.props;
---

<div class="side-switch" data-switch>
  <nav class="lang-switch" aria-label={ui[lang].language}>
    {
      LANGS.map((l) => (
        <a
          class="lang-switch__btn"
          href={localePath(l, path)}
          hreflang={l}
          lang={l}
          aria-current={l === lang ? 'page' : undefined}
          data-lang-link={l}
        >
          {ui[l].langShort}<span class="visually-hidden"> {ui[l].langName}</span>
        </a>
      ))
    }
  </nav>
  {/* White copy, clipped to the part of the switch the footer covers. Not interactive. */}
  <div class="lang-switch lang-switch--copy" aria-hidden="true" inert data-switch-copy>
    {
      LANGS.map((l) => (
        <span class:list={['lang-switch__btn', { 'is-current': l === lang }]}>{ui[l].langShort}</span>
      ))
    }
  </div>
</div>

<script>
  import '../scripts/lang-switch';
  import '../scripts/shell/switch-copy';
</script>
