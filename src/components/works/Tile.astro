---
import { localePath, imgPath, workPath } from '../../lib/paths';
import type { Lang } from '../../i18n/ui';
import { mediumLabels, searchText, type Medium, type Project } from '../../lib/projects';

interface Props {
  lang: Lang;
  project: Project;
  mediums: Medium[];
}
const { lang, project: p, mediums } = Astro.props;
const cover = p.media.cover;
---

<li
  class="tile"
  data-id={p.id}
  data-search={searchText(p, mediums)}
  data-authors={p.authors.join('\n')}
  data-mediums={p.mediums.join(' ')}
  data-year={p.year}
  data-study={p.study}
>
  <a class="tile__link" href={localePath(lang, workPath(p.id))}>
    <span class="tile__media">
      <img
        class="tile__img"
        src={imgPath(cover.thumb)}
        data-preview={p.media.preview ? imgPath(p.media.preview) : undefined}
        width={cover.w}
        height={cover.h}
        alt=""
        loading="lazy"
        decoding="async"
      />
    </span>
    <span class="tile__title">{p.title[lang]}</span>
    <span class="tile__meta"
      ><span class="tile__authors">{p.authors.join(', ')}</span><span class="tile__sep" aria-hidden="true"> · </span
      ><span class="tile__mediums">{mediumLabels(p, mediums, lang).join(', ')}</span><span
        class="tile__sep tile__sep--mediums"
        aria-hidden="true"> · </span
      ><span class="tile__year">{p.year}</span></span
    >
  </a>
</li>
